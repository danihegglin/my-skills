{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domainikus",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CACHE", "class_name": "Cache" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Cache"] }],
  "ratelimits": [
    { "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
