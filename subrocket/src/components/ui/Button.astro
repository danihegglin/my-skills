---
import type { HTMLAttributes } from 'astro/types'
import { ArrowRight } from '@lucide/astro'

type Props = HTMLAttributes<'a'> & {
  variant?: 'primary' | 'outline' | 'pop' | 'ghost-light'
  size?: 'md' | 'sm'
  arrow?: boolean
}

const { variant = 'primary', size = 'md', arrow = false, class: className, ...rest } = Astro.props

const base =
  'group inline-flex items-center justify-center gap-2 rounded-full font-medium whitespace-nowrap transition-[background-color,color,border-color,translate,box-shadow] duration-200 ease-out active:translate-y-px'
const sizes = {
  md: 'h-12 px-6 text-[0.97rem]',
  sm: 'h-9 px-4 text-sm',
}
const variants = {
  primary: 'bg-ink text-paper shadow-[0_10px_24px_-12px_oklch(20%_0.02_45/0.7)] hover:bg-pop-deep',
  outline: 'border border-line-strong bg-card/60 text-ink hover:border-ink',
  pop: 'bg-pop text-ink hover:bg-paper',
  'ghost-light': 'text-paper/85 hover:bg-paper/10 hover:text-paper',
}
---

<a class:list={[base, sizes[size], variants[variant], className]} {...rest}>
  <slot />
  {arrow && <ArrowRight class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />}
</a>
