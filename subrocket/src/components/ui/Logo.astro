---
// Mark: an open ring (the subscription loop) with a dot breaking out of the gap (the launch).
// Wordmark: Geist, lowercase, tight.
interface Props {
  class?: string
  tone?: 'dark' | 'light'
}
const { class: className = '', tone = 'dark' } = Astro.props
---

<a href="/" class:list={['group inline-flex items-center gap-2 rounded-md', tone === 'light' ? 'text-paper' : 'text-ink', className]} aria-label="subrocket home">
  <svg viewBox="0 0 24 24" class="size-[1.45rem] shrink-0" aria-hidden="true">
    <path d="M19.73 9.93A8 8 0 1 1 14.07 4.27" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
    <circle cx="19.6" cy="4.4" r="2.5" class="fill-pop transition-transform duration-500 ease-out group-hover:translate-x-[1.5px] group-hover:-translate-y-[1.5px]" />
  </svg>
  <span class="font-sans text-[1.3rem] font-semibold leading-none tracking-[-0.045em]" aria-hidden="true">subrocket</span>
</a>
