---
const leaks = [
  {
    where: 'At checkout',
    title: 'Gift buyers leave',
    body: 'Someone wants to give your subscription to a friend. Your checkout only sells to the person paying, so they close the tab.',
  },
  {
    where: 'At renewal',
    title: 'Expired cards fail',
    body: 'Card networks don’t update every expired card. When one slips through, the renewal fails and a customer who never decided to leave is gone.',
  },
  {
    where: 'At cancellation',
    title: 'Breaks become cancels',
    body: 'A customer who wants a month off has two choices: email support or cancel. Cancel is the button they can find.',
  },
]
---

<section class="relative border-y border-border bg-ink-2 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="telemetry text-signal">The problem</p>
        <h2 class="mt-4 text-4xl font-extrabold sm:text-5xl">Three places subscription revenue leaks</h2>
        <p class="mt-6 text-lg leading-relaxed text-haze">Stripe handles the charge. What happens before the first charge and around the next one is up to you.</p>
      </div>
      <ol class="grid gap-px overflow-hidden rounded-2xl border border-border bg-border lg:col-span-8">
        {leaks.map((leak, i) => (
          <li class="group grid gap-4 bg-ink-2 p-7 transition-colors hover:bg-ink-3 sm:grid-cols-[7rem_1fr] sm:p-9" data-reveal style={`transition-delay: ${i * 90}ms`}>
            <span class="font-display text-6xl font-extrabold text-white/10 transition-colors group-hover:text-signal">0{i + 1}</span>
            <div>
              <p class="telemetry text-haze">{leak.where}</p>
              <h3 class="mt-2 text-2xl font-bold">{leak.title}</h3>
              <p class="mt-3 max-w-xl leading-relaxed text-haze">{leak.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
