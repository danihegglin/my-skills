---
import { Card, CardContent } from '@/components/ui/card'
import { Badge } from '@/components/ui/badge'
import { Check, Gift, MailCheck, Pause, Database, ChartColumn, Webhook } from '@lucide/astro'

const reasons = [
  { label: 'Taking a break', value: 41 },
  { label: 'Too expensive', value: 27 },
  { label: 'Too much coffee', value: 19 },
]
---

<section id="modules" class="relative border-y border-border bg-white py-24 sm:py-32">
  <div class="bg-dots absolute inset-0 [mask-image:linear-gradient(to_bottom,black,transparent_35%)]" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow text-primary">The fix</p>
      <h2 class="mt-4 text-4xl font-semibold sm:text-5xl">One app for all three</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">Turn on the modules you need. Each one works on its own and reads straight from your Stripe account.</p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-6">
      <!-- Gift checkout -->
      <Card id="checkout" className="gap-0 overflow-hidden rounded-3xl py-0 shadow-none lg:col-span-3" data-reveal>
        <CardContent className="flex h-full flex-col p-7 sm:p-9">
          <Badge variant="secondary" className="w-fit rounded-full font-mono text-[0.7rem]">01 · Gift checkout</Badge>
          <h3 class="mt-5 text-3xl font-semibold">A checkout that also sells to gift-givers</h3>
          <p class="mt-4 leading-relaxed text-muted-foreground">One page with Apple Pay, Google Pay and cards through Stripe. Buyers tick “This is a gift”, pick a delivery date and write a message. On that date the recipient gets an email and claims the subscription with their own account.</p>
          <ul class="mt-6 space-y-2.5 text-sm">
            {['Prepaid gifts of 3, 6 or 12 months', 'Coupons and trials from your Stripe prices', 'Your domain, logo and colors'].map((p) => (
              <li class="flex items-start gap-2.5"><Check class="mt-0.5 size-4 shrink-0 text-primary" />{p}</li>
            ))}
          </ul>
          <div class="mt-auto pt-8">
            <div class="relative rounded-2xl border border-border bg-frost p-5">
              <div class="flex items-center gap-3">
                <span class="flex size-10 items-center justify-center rounded-full bg-primary text-white"><Gift class="size-5" /></span>
                <div>
                  <p class="text-sm font-semibold">Sam sent you 3 months of Roast Club</p>
                  <p class="text-xs text-muted-foreground">Delivered Dec 24, 8:00</p>
                </div>
              </div>
              <p class="mt-4 rounded-xl bg-white p-3 text-sm italic text-muted-foreground">“Three months of good mornings. Love, Sam”</p>
              <div class="mt-3 flex h-9 items-center justify-center rounded-lg bg-primary text-sm font-semibold text-white">Claim your gift</div>
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Card rescue -->
      <Card id="rescue" className="gap-0 overflow-hidden rounded-3xl py-0 shadow-none lg:col-span-3" data-reveal style={{ transitionDelay: "90ms" }}>
        <CardContent className="flex h-full flex-col p-7 sm:p-9">
          <Badge variant="secondary" className="w-fit rounded-full font-mono text-[0.7rem]">02 · Card rescue</Badge>
          <h3 class="mt-5 text-3xl font-semibold">New card details before the old card expires</h3>
          <p class="mt-4 leading-relaxed text-muted-foreground">SubRocket reads the expiry date on every customer’s default card. Thirty days out it emails a one-tap update link, then reminds them at seven days and one day. The reminders stop the moment the card is updated.</p>
          <ul class="mt-6 space-y-2.5 text-sm">
            {['Branded emails you can edit', 'Update links hosted by Stripe', 'Same-day recovery email if a renewal still fails'].map((p) => (
              <li class="flex items-start gap-2.5"><Check class="mt-0.5 size-4 shrink-0 text-primary" />{p}</li>
            ))}
          </ul>
          <div class="mt-auto pt-8">
            <div class="rounded-2xl border border-border bg-white shadow-[0_20px_40px_-28px_rgb(20_48_127/0.45)]">
              <div class="flex items-center justify-between border-b border-border px-5 py-3 text-xs text-muted-foreground">
                <span>From: Roast Club</span><span>30 days before expiry</span>
              </div>
              <div class="p-5">
                <p class="font-semibold">Your card ending 0341 expires next month</p>
                <p class="mt-1 text-sm text-muted-foreground">Update it now so your next delivery ships on time.</p>
                <div class="mt-4 flex items-center justify-between gap-3">
                  <span class="inline-flex h-9 items-center rounded-lg bg-primary px-4 text-sm font-semibold text-white">Update card</span>
                  <span class="inline-flex items-center gap-1.5 text-xs font-medium text-saved-ink"><MailCheck class="size-4" /> Updated 3 days later</span>
                </div>
              </div>
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Self-service -->
      <Card id="portal" className="gap-0 overflow-hidden rounded-3xl py-0 shadow-none lg:col-span-4" data-reveal>
        <CardContent className="grid h-full gap-8 p-7 sm:p-9 md:grid-cols-2 md:items-center">
          <div>
            <Badge variant="secondary" className="w-fit rounded-full font-mono text-[0.7rem]">03 · Self-service</Badge>
            <h3 class="mt-5 text-3xl font-semibold">Customers pause instead of cancelling</h3>
            <p class="mt-4 leading-relaxed text-muted-foreground">A portal where customers pause for one to three months, switch plans, move their billing date and update their card. Cancel stays one click away, and before it confirms, SubRocket offers a pause or a cheaper plan.</p>
          </div>
          <div class="rounded-2xl border border-border bg-frost p-5">
            <p class="text-sm font-semibold">Before you go</p>
            <p class="mt-1 text-sm text-muted-foreground">Take two months off instead?</p>
            <div class="mt-4 space-y-2">
              <div class="flex items-center gap-2.5 rounded-xl border border-primary bg-white px-4 py-3 text-sm font-medium text-accent-foreground"><Pause class="size-4" /> Pause until Jan 3</div>
              <div class="rounded-xl border border-border bg-white px-4 py-3 text-sm text-muted-foreground">Switch to Lite, $16/mo</div>
              <div class="px-4 py-2 text-sm text-muted-foreground underline underline-offset-4">Cancel anyway</div>
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Stripe -->
      <Card className="gap-0 rounded-3xl border-transparent bg-gradient-to-br from-cobalt to-cobalt-deep py-0 text-white shadow-none lg:col-span-2" data-reveal style={{ transitionDelay: "90ms" }}>
        <CardContent className="flex h-full flex-col p-7 sm:p-9">
          <span class="flex size-11 items-center justify-center rounded-xl bg-white/15"><Database class="size-5" /></span>
          <h3 class="mt-6 text-2xl font-semibold">Stripe stays the source of truth</h3>
          <p class="mt-3 leading-relaxed text-white/75">Customers, subscriptions and invoices live in your Stripe account. SubRocket reads and writes through the Stripe API, so your finance reports don’t change.</p>
        </CardContent>
      </Card>

      <!-- Analytics -->
      <Card className="gap-0 rounded-3xl py-0 shadow-none lg:col-span-3" data-reveal>
        <CardContent className="p-7 sm:p-9">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="text-2xl font-semibold">Why people leave</h3>
              <p class="mt-2 text-muted-foreground">Cancellation reasons and accepted save offers, by plan and by month.</p>
            </div>
            <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-frost text-primary"><ChartColumn class="size-5" /></span>
          </div>
          <div class="mt-6 space-y-3" aria-label="Example cancellation reasons">
            {reasons.map((r) => (
              <div>
                <div class="flex justify-between text-xs text-muted-foreground"><span>{r.label}</span><span class="font-mono">{r.value}%</span></div>
                <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-muted"><div class="h-full rounded-full bg-gradient-to-r from-primary to-[#5b8cff]" style={`width: ${r.value * 2}%`}></div></div>
              </div>
            ))}
          </div>
          <p class="mt-3 text-[0.7rem] text-muted-foreground">Example data</p>
        </CardContent>
      </Card>

      <!-- Webhooks -->
      <Card className="gap-0 rounded-3xl py-0 shadow-none lg:col-span-3" data-reveal style={{ transitionDelay: "90ms" }}>
        <CardContent className="p-7 sm:p-9">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="text-2xl font-semibold">Webhooks for your app</h3>
              <p class="mt-2 text-muted-foreground">Get an event when a gift is claimed, a card is updated or a subscription is paused.</p>
            </div>
            <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-frost text-primary"><Webhook class="size-5" /></span>
          </div>
          <ul class="mt-6 space-y-2 font-mono text-[0.78rem]">
            {['gift.claimed', 'card.updated', 'subscription.paused'].map((e) => (
              <li class="flex items-center justify-between rounded-lg border border-border bg-muted/40 px-3 py-2">
                <span>{e}</span><span class="rounded bg-saved-soft px-1.5 py-0.5 text-[0.68rem] text-saved-ink">200 OK</span>
              </li>
            ))}
          </ul>
        </CardContent>
      </Card>
    </div>
  </div>
</section>
