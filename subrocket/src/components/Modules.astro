---
import { Check } from '@lucide/astro'
import CheckoutMockup from './CheckoutMockup.astro'
import RescueTimeline from './RescueTimeline.astro'
import PortalMockup from './PortalMockup.astro'

const modules = [
  {
    id: 'checkout',
    tag: '01 / Gift checkout',
    title: 'A checkout that also sells to gift-givers',
    body: 'One page with Apple Pay, Google Pay and cards through Stripe. Buyers tick “This is a gift”, pick a delivery date and write a message. On that date the recipient gets an email and claims the subscription with their own account.',
    points: ['Prepaid gifts of 3, 6 or 12 months', 'Coupons and trials from your Stripe prices', 'Your domain, logo and colors'],
    visual: 'checkout',
  },
  {
    id: 'rescue',
    tag: '02 / Card rescue',
    title: 'New card details before the old card expires',
    body: 'SubRocket reads the expiry date on every customer’s default card. Thirty days out it emails a one-tap update link, then reminds them at seven days and one day. The reminders stop the moment the card is updated.',
    points: ['Branded emails you can edit', 'Update links hosted by Stripe', 'Same-day recovery email if a renewal still fails'],
    visual: 'rescue',
  },
  {
    id: 'portal',
    tag: '03 / Self-service',
    title: 'Customers pause instead of cancelling',
    body: 'A portal where customers pause for one to three months, switch plans, move their billing date and update their card. Cancel is always one click away. Before it confirms, SubRocket offers a pause or a cheaper plan and asks why they’re leaving.',
    points: ['Pause, switch, reschedule, cancel', 'One save offer per cancellation', 'Cancellation reasons by plan and month'],
    visual: 'portal',
  },
]
---

<section class="relative overflow-x-clip py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-3xl" data-reveal>
      <p class="telemetry text-signal">The fix</p>
      <h2 class="mt-4 text-4xl font-extrabold sm:text-6xl">One app for the three leaks</h2>
      <p class="mt-6 text-lg leading-relaxed text-haze">Turn on the modules you need. Each one works on its own and reads straight from your Stripe account.</p>
    </div>

    <div class="mt-20 space-y-28 sm:space-y-36">
      {modules.map((m, i) => (
        <article id={m.id} class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
          <div class:list={['lg:col-span-6', i % 2 === 1 && 'lg:order-2 lg:col-start-7']} data-reveal>
            <p class="telemetry text-mint">{m.tag}</p>
            <h3 class="mt-4 text-3xl font-extrabold sm:text-5xl">{m.title}</h3>
            <p class="mt-6 text-lg leading-relaxed text-haze">{m.body}</p>
            <ul class="mt-8 space-y-3">
              {m.points.map((p) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-signal/15 text-signal"><Check class="size-3.5" /></span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class:list={['relative flex justify-center lg:col-span-6', i % 2 === 1 && 'lg:order-1 lg:col-start-1']} data-reveal style="transition-delay: 120ms">
            <div class="absolute inset-0 -z-10 rounded-[2.5rem] bg-grid opacity-60 [mask-image:radial-gradient(circle,black,transparent_70%)]" aria-hidden="true"></div>
            <div class="w-full max-w-md transition-transform duration-700 hover:-rotate-1 hover:scale-[1.02]">
              {m.visual === 'checkout' && <CheckoutMockup />}
              {m.visual === 'rescue' && <RescueTimeline />}
              {m.visual === 'portal' && <PortalMockup />}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
