---
import QuoteAvatar from './QuoteAvatar'

// SAMPLE QUOTES: replace with real, attributed customer quotes before launch.
const testimonials = [
  {
    quote: 'We sold gift subscriptions for the first time last December. Our old checkout had no way to do it.',
    name: 'Founder',
    company: 'Coffee subscription',
    initials: 'CS',
    offset: false,
  },
  {
    quote: 'Expiry emails go out a month ahead now. Most customers update their card before we ever see a failed renewal.',
    name: 'Head of Growth',
    company: 'Fitness app',
    initials: 'FA',
    offset: true,
  },
  {
    quote: 'Customers who used to email “please cancel” now pause for two months and come back.',
    name: 'Support Lead',
    company: 'Meal kit service',
    initials: 'MK',
    offset: false,
  },
  {
    quote: 'Everything still lives in Stripe, so our finance team didn’t have to change a single report.',
    name: 'CTO',
    company: 'B2B SaaS',
    initials: 'BS',
    offset: true,
  },
]
---

<section class="py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-2xl" data-reveal>
      <p class="telemetry text-signal">From subscription teams</p>
      <h2 class="mt-4 text-4xl font-extrabold sm:text-5xl">What changes after launch</h2>
    </div>
    <div class="mt-16 grid gap-6 md:grid-cols-2">
      {testimonials.map((t, i) => (
        <figure
          class:list={[
            'group relative flex flex-col justify-between rounded-2xl border border-border bg-gradient-to-br from-ink-2 to-ink p-8 transition-all duration-300 hover:-translate-y-1 hover:border-mint/40 sm:p-10',
            t.offset && 'md:translate-y-12 md:hover:translate-y-11',
          ]}
          data-reveal
          style={`transition-delay: ${i * 80}ms`}
        >
          <span class="absolute right-8 top-4 font-display text-8xl leading-none text-signal/20 transition-colors group-hover:text-signal/40" aria-hidden="true">“</span>
          <blockquote class="relative font-display text-xl font-semibold leading-snug sm:text-2xl">{t.quote}</blockquote>
          <figcaption class="mt-8 flex items-center gap-4">
            <QuoteAvatar initials={t.initials} />
            <div>
              <p class="font-semibold">{t.name}, {t.company}</p>
              <p class="telemetry mt-1 text-[0.65rem] text-signal">Sample quote</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
