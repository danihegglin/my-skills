---
import { Database, ChartColumn, Webhook } from '@lucide/astro'

const extras = [
  {
    icon: Database,
    title: 'Stripe stays the source of truth',
    body: 'Customers, subscriptions and invoices live in your Stripe account. SubRocket reads and writes through the Stripe API, so your finance reports don’t change.',
    wide: true,
  },
  {
    icon: ChartColumn,
    title: 'Why people leave',
    body: 'Cancellation reasons and accepted save offers, by plan and by month.',
    wide: false,
  },
  {
    icon: Webhook,
    title: 'Webhooks for your app',
    body: 'Get an event when a gift is claimed, a card is updated or a subscription is paused.',
    wide: false,
  },
]
---

<section class="pb-24 sm:pb-32">
  <div class="mx-auto grid max-w-7xl gap-5 px-5 sm:px-8 md:grid-cols-4">
    {extras.map((e, i) => (
      <div
        class:list={[
          'group relative overflow-hidden rounded-2xl border border-border bg-ink-2 p-8 transition-all duration-300 hover:-translate-y-1 hover:border-signal/40',
          e.wide ? 'md:col-span-2' : 'md:col-span-1',
        ]}
        data-reveal
        style={`transition-delay: ${i * 90}ms`}
      >
        <div class="absolute -right-10 -top-10 size-32 rounded-full bg-signal/10 blur-2xl transition-opacity group-hover:opacity-100 opacity-0" aria-hidden="true"></div>
        <div class="flex size-12 items-center justify-center rounded-xl bg-gradient-to-br from-signal to-signal-soft text-ink shadow-[0_10px_30px_-10px_rgb(255_106_61/0.8)]">
          <e.icon class="size-6" />
        </div>
        <h3 class="mt-6 text-xl font-bold">{e.title}</h3>
        <p class="mt-3 leading-relaxed text-haze">{e.body}</p>
      </div>
    ))}
  </div>
</section>
