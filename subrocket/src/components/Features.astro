---
import { Badge } from '@/components/ui/badge'
import { Card, CardContent } from '@/components/ui/card'
import { Check, Gift, MailCheck, Pause, Database, Webhook, ChartColumn } from '@lucide/astro'
import { cn } from '@/lib/utils'

const features = [
  {
    id: 'checkout',
    tag: 'Gift checkout',
    stat: '2×',
    statLabel: 'as many shoppers want to give a subscription as ever have',
    src: 1,
    title: 'Sell to gift-givers',
    body: 'A gift toggle at checkout. Buyers prepay 3, 6 or 12 months and pick a delivery date.',
    points: [
      { text: 'Apple Pay and Google Pay built in', note: '+22% conversion', src: 2 },
      { text: 'Recipients claim with their own account' },
      { text: 'Your domain and branding' },
    ],
    visual: 'gift',
  },
  {
    id: 'rescue',
    tag: 'Card rescue',
    stat: '53%',
    statLabel: 'of subscription churn is a failed payment',
    src: 3,
    title: 'Fix cards before they fail',
    body: 'Update links go out 30, 7 and 1 day before a card expires, and stop once it’s updated.',
    points: [{ text: 'Branded emails you can edit' }, { text: 'Card update page hosted by Stripe' }, { text: 'Same-day email if a renewal fails' }],
    visual: 'email',
  },
  {
    id: 'portal',
    tag: 'Self-service',
    stat: '1 in 10',
    statLabel: 'cancellations saved just by offering a pause',
    src: 4,
    title: 'Turn cancels into pauses',
    body: 'Customers pause, switch plans or move dates themselves. Cancel shows one save offer first.',
    points: [{ text: 'Pause for 1 to 3 months' }, { text: 'Plan switch and date change' }, { text: 'Churn reasons by plan' }],
    visual: 'pause',
  },
]

const extras = [
  { icon: Database, text: 'Your data stays in Stripe' },
  { icon: Webhook, text: 'Webhooks for every event' },
  { icon: ChartColumn, text: 'Churn and save reports' },
]
---

<section id="features" class="relative border-y border-border bg-white py-24 sm:py-32">
  <div class="bg-dots absolute inset-0 [mask-image:linear-gradient(to_bottom,black,transparent_30%)]" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow text-primary">Three modules</p>
      <h2 class="mt-4 text-4xl font-semibold sm:text-5xl">More signups in. <span class="accent-serif text-primary">Fewer</span> subscribers out.</h2>
    </div>

    <div class="mt-14 space-y-6">
      {features.map((f, i) => (
        <Card id={f.id} className="scroll-mt-28 gap-0 overflow-hidden rounded-[1.75rem] py-0 shadow-none transition-shadow duration-300 hover:shadow-[0_30px_60px_-36px_rgb(5_61_41/0.45)]" data-reveal>
          <CardContent className="grid gap-10 p-7 sm:p-10 lg:grid-cols-2 lg:items-center lg:gap-14">
            <div class={cn(i % 2 === 1 && 'lg:order-2')}>
              <Badge variant="secondary" className="rounded-full font-mono text-[0.7rem]">0{i + 1} · {f.tag}</Badge>
              <div class="mt-6 flex items-end gap-4">
                <p class="font-display text-6xl font-semibold leading-none tracking-tight text-primary sm:text-7xl">{f.stat}</p>
                <p class="max-w-[14rem] pb-1 text-sm leading-snug text-muted-foreground">{f.statLabel}<a href="#sources" class="ml-0.5 align-super text-[0.65rem] text-primary hover:underline">{f.src}</a></p>
              </div>
              <h3 class="mt-8 text-3xl font-semibold">{f.title}</h3>
              <p class="mt-3 max-w-md text-lg leading-relaxed text-muted-foreground">{f.body}</p>
              <ul class="mt-6 space-y-2.5">
                {f.points.map((p) => (
                  <li class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
                    <span class="flex size-5 items-center justify-center rounded-full bg-accent text-primary"><Check class="size-3.5" /></span>
                    <span>{p.text}</span>
                    {p.note && (
                      <span class="rounded-full bg-lime/60 px-2 py-0.5 text-xs font-semibold text-brand-deep">{p.note}<a href="#sources" class="ml-0.5 align-super text-[0.6rem] hover:underline">{p.src}</a></span>
                    )}
                  </li>
                ))}
              </ul>
            </div>

            <div class={cn('relative', i % 2 === 1 && 'lg:order-1')}>
              <div class="flex min-h-[18rem] items-center justify-center rounded-3xl bg-gradient-to-br from-mint/70 to-frost p-6 sm:p-10">
                {f.visual === 'gift' && (
                  <div class="w-full max-w-sm rotate-[-1.5deg] rounded-2xl border border-border bg-white p-5 shadow-[0_24px_50px_-28px_rgb(5_61_41/0.5)] transition-transform duration-500 hover:rotate-0">
                    <div class="flex items-center gap-3">
                      <span class="flex size-10 items-center justify-center rounded-full bg-primary text-white"><Gift class="size-5" /></span>
                      <div>
                        <p class="text-sm font-semibold">Sam sent you 3 months of Roast Club</p>
                        <p class="text-xs text-muted-foreground">Delivered Dec 24</p>
                      </div>
                    </div>
                    <p class="mt-4 rounded-xl bg-frost p-3 text-sm italic text-muted-foreground">“Three months of good mornings.”</p>
                    <div class="mt-3 flex h-10 items-center justify-center rounded-lg bg-primary text-sm font-semibold text-white">Claim your gift</div>
                  </div>
                )}
                {f.visual === 'email' && (
                  <div class="w-full max-w-sm rotate-[1.5deg] rounded-2xl border border-border bg-white shadow-[0_24px_50px_-28px_rgb(5_61_41/0.5)] transition-transform duration-500 hover:rotate-0">
                    <div class="flex items-center justify-between border-b border-border px-5 py-3 text-xs text-muted-foreground">
                      <span>Roast Club</span><span>30 days before expiry</span>
                    </div>
                    <div class="p-5">
                      <p class="font-semibold">Your card ending 0341 expires soon</p>
                      <p class="mt-1 text-sm text-muted-foreground">Update it so your next bag ships on time.</p>
                      <div class="mt-4 flex items-center justify-between gap-3">
                        <span class="inline-flex h-9 items-center rounded-lg bg-primary px-4 text-sm font-semibold text-white">Update card</span>
                        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-accent-foreground"><MailCheck class="size-4" /> Updated</span>
                      </div>
                    </div>
                  </div>
                )}
                {f.visual === 'pause' && (
                  <div class="w-full max-w-sm rotate-[-1.5deg] rounded-2xl border border-border bg-white p-5 shadow-[0_24px_50px_-28px_rgb(5_61_41/0.5)] transition-transform duration-500 hover:rotate-0">
                    <p class="font-semibold">Before you go</p>
                    <p class="mt-1 text-sm text-muted-foreground">Take two months off instead?</p>
                    <div class="mt-4 space-y-2 text-sm">
                      <div class="flex items-center gap-2.5 rounded-xl border border-primary bg-accent px-4 py-3 font-medium text-accent-foreground"><Pause class="size-4" /> Pause until Jan 3</div>
                      <div class="rounded-xl border border-border px-4 py-3 text-muted-foreground">Switch to Lite, $16/mo</div>
                      <div class="px-4 pt-1 text-muted-foreground underline underline-offset-4">Cancel anyway</div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </CardContent>
        </Card>
      ))}
    </div>

    <ul class="mt-6 grid gap-3 sm:grid-cols-3" data-reveal>
      {extras.map((e) => (
        <li class="flex items-center gap-3 rounded-2xl border border-border bg-background px-5 py-4 text-sm font-medium">
          <span class="flex size-9 items-center justify-center rounded-xl bg-accent text-primary"><e.icon class="size-4" /></span>
          {e.text}
        </li>
      ))}
    </ul>
  </div>
</section>
