---
// Product visual: the customer self-service portal with the pause flow.
import { Pause, ArrowLeftRight, CalendarDays, X } from '@lucide/astro'
---

<div class="rounded-2xl border border-white/10 bg-ink p-6 shadow-2xl sm:p-7">
  <p class="telemetry text-haze">Your subscription</p>
  <div class="mt-2 flex items-baseline justify-between">
    <p class="font-display text-2xl font-bold">Roast Club</p>
    <p class="text-sm text-haze">Renews Nov 3</p>
  </div>

  <div class="mt-5 rounded-xl border border-mint/40 bg-mint/10 p-4">
    <p class="flex items-center gap-2 text-sm font-semibold text-mint"><Pause class="size-4" /> Pause deliveries</p>
    <div class="mt-3 grid grid-cols-3 gap-2 text-center text-sm font-semibold">
      <span class="rounded-lg bg-ink px-2 py-2">1 month</span>
      <span class="rounded-lg bg-mint px-2 py-2 text-ink">2 months</span>
      <span class="rounded-lg bg-ink px-2 py-2">3 months</span>
    </div>
    <p class="mt-3 text-xs text-haze">Billing resumes Jan 3. You won’t be charged while paused.</p>
  </div>

  <ul class="mt-4 divide-y divide-border rounded-xl border border-border text-sm">
    <li class="flex items-center gap-3 px-4 py-3"><ArrowLeftRight class="size-4 text-haze" /> Switch plan</li>
    <li class="flex items-center gap-3 px-4 py-3"><CalendarDays class="size-4 text-haze" /> Change billing date</li>
    <li class="flex items-center gap-3 px-4 py-3 text-haze"><X class="size-4" /> Cancel subscription</li>
  </ul>
</div>
