---
import { Separator } from '@/components/ui/separator'
import Logo from './Logo.astro'

const year = new Date().getFullYear()

const sources = [
  { label: 'Recurly, Holiday subscription trends 2023: 53% of shoppers want to give a subscription, 27% have', href: 'https://recurly.com/blog/holiday-subscription-trends-consumer-report/' },
  { label: 'Stripe, payment method study: 22.3% average conversion lift when offering Apple Pay', href: 'https://stripe.com/blog/testing-the-conversion-impact-of-50-plus-global-payment-methods' },
  { label: 'Recurly, churn rate guide: 53% of churn is involuntary', href: 'https://recurly.com/blog/churn-rate-guide/' },
  { label: 'Recharge: 9.6% average save rate across 1,700+ merchants offering pause', href: 'https://getrecharge.com/blog/reduce-your-cancellations-by-10-with-pause-subscriptions/' },
]

const columns = [
  {
    title: 'Product',
    links: [
      { href: '/#checkout', label: 'Gift checkout' },
      { href: '/#rescue', label: 'Card rescue' },
      { href: '/#portal', label: 'Self-service portal' },
      { href: '/pricing', label: 'Pricing' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { href: '/blog', label: 'Blog' },
      { href: 'mailto:hello@subrocket.com', label: 'Contact' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/privacy', label: 'Privacy policy' },
      { href: '/terms', label: 'Terms of service' },
      { href: '/dpa', label: 'Data processing agreement' },
      { href: '/imprint', label: 'Imprint' },
    ],
  },
]
---

<footer class="border-t border-border bg-white">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo />
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-muted-foreground">Gift checkout, card rescue and self-service for subscription brands.</p>
        <a href="mailto:hello@subrocket.com" class="mt-6 inline-flex items-center rounded-full border border-border px-4 py-2 text-sm font-medium transition-colors hover:border-pop/40 hover:bg-accent hover:text-accent-foreground">hello@subrocket.com</a>
      </div>
      {columns.map((col) => (
        <nav aria-label={col.title} class="md:col-span-2 lg:col-span-2">
          <h3 class="eyebrow text-[0.68rem] text-muted-foreground">{col.title}</h3>
          <ul class="mt-5 space-y-3 text-sm">
            {col.links.map((l) => (
              <li><a href={l.href} class="text-foreground/80 transition-colors hover:text-pop">{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <Separator className="my-10" />
    <ol id="sources" class="scroll-mt-28 space-y-1 text-xs text-muted-foreground">
      {sources.map((src, i) => (
        <li><span class="font-mono">{i + 1}.</span> <a href={src.href} rel="noopener" target="_blank" class="underline decoration-border underline-offset-2 hover:text-pop">{src.label}</a></li>
      ))}
    </ol>
    <Separator className="my-8" />
    <div class="flex flex-col justify-between gap-4 text-xs text-muted-foreground sm:flex-row">
      <p>&copy; {year} subrocket. All rights reserved.</p>
      <p>Stripe is a trademark of Stripe, Inc. subrocket is an independent product.</p>
    </div>
  </div>
</footer>
