---
const steps = [
  { title: 'Connect Stripe', body: 'Products and prices import automatically.' },
  { title: 'Choose what to turn on', body: 'Gift boxes, card rescue, skipping.' },
  { title: 'Swap two links', body: 'Checkout and account page. Done.' },
]
---

<section id="setup" class="py-24 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end" data-reveal>
      <h2 class="text-4xl font-semibold sm:text-5xl">Live in an <span class="accent-text">afternoon</span></h2>
      <p class="text-muted-foreground">No code changes to your Stripe products.</p>
    </div>
    <ol class="mt-12 grid gap-4 md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="group relative rounded-3xl border border-border bg-white p-7 transition-colors hover:border-pop/40" data-reveal style={`transition-delay: ${i * 90}ms`}>
          <span class="font-display text-5xl font-semibold text-pop/25 transition-colors group-hover:text-pop">{i + 1}</span>
          <h3 class="mt-4 text-xl font-semibold">{s.title}</h3>
          <p class="mt-1.5 text-muted-foreground">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
