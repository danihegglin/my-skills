---
const steps = [
  { title: 'Connect Stripe', body: 'Authorize SubRocket with Stripe Connect. Your products and prices import on their own.' },
  { title: 'Pick your modules', body: 'Turn on gifting, card rescue and the portal. Edit the email copy and your save offer.' },
  { title: 'Swap two links', body: 'Point your pricing buttons at your SubRocket checkout and your account page at the portal.' },
]
---

<section class="relative overflow-hidden border-y border-border bg-ink-2 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
      <div>
        <p class="telemetry text-signal">Launch sequence</p>
        <h2 class="mt-4 text-4xl font-extrabold sm:text-5xl">Set up in an afternoon</h2>
      </div>
      <p class="max-w-sm text-haze">No code changes to your Stripe products. Your developers only touch two links.</p>
    </div>
    <ol class="mt-16 grid gap-10 md:grid-cols-3 md:gap-6">
      {steps.map((s, i) => (
        <li class="relative" data-reveal style={`transition-delay: ${i * 120}ms`}>
          <div class="flex items-center gap-4">
            <span class="font-mono text-sm text-signal">T-{3 - i}</span>
            <span class="h-px flex-1 bg-gradient-to-r from-signal/60 to-transparent"></span>
          </div>
          <h3 class="mt-5 text-2xl font-bold">{s.title}</h3>
          <p class="mt-3 leading-relaxed text-haze">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
