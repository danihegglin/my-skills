---
import { Card, CardContent } from '@/components/ui/card'
import { ArrowRight } from '@lucide/astro'

const steps = [
  { title: 'Connect Stripe', body: 'Authorize SubRocket with Stripe Connect. Your products and prices import on their own.' },
  { title: 'Pick your modules', body: 'Turn on gifting, card rescue and the portal. Edit the email copy and your save offer.' },
  { title: 'Swap two links', body: 'Point your pricing buttons at your SubRocket checkout and your account page at the portal.' },
]

const links = [
  { where: 'Pricing page button', from: 'checkout.stripe.com/c/pay/…', to: 'pay.roastclub.com/monthly' },
  { where: 'Account page link', from: 'billing.stripe.com/p/session/…', to: 'account.roastclub.com' },
]
---

<section id="setup" class="py-24 sm:py-32">
  <div class="mx-auto grid max-w-6xl gap-14 px-4 sm:px-6 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div data-reveal>
      <p class="eyebrow text-primary">Setup</p>
      <h2 class="mt-4 text-4xl font-semibold sm:text-5xl">Live in an <span class="accent-serif text-primary">afternoon</span></h2>
      <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">No code changes to your Stripe products. Your developers only touch two links.</p>

      <ol class="mt-10 space-y-8">
        {steps.map((s, i) => (
          <li class="relative flex gap-5">
            {i < steps.length - 1 && <span class="absolute left-[19px] top-11 h-[calc(100%-1rem)] w-px bg-border" aria-hidden="true"></span>}
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full border border-primary/30 bg-frost font-mono text-sm font-medium text-primary">{i + 1}</span>
            <div class="pt-1.5">
              <h3 class="text-xl font-semibold">{s.title}</h3>
              <p class="mt-1.5 leading-relaxed text-muted-foreground">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="lg:pt-24" data-reveal style="transition-delay: 120ms">
      <Card className="gap-0 rounded-3xl py-0 shadow-[0_40px_80px_-40px_rgb(20_48_127/0.4)]">
        <CardContent className="p-6 sm:p-8">
          <p class="eyebrow text-[0.68rem] text-muted-foreground">Step 3 · the only change on your site</p>
          <div class="mt-6 space-y-5">
            {links.map((l) => (
              <div>
                <p class="text-sm font-semibold">{l.where}</p>
                <div class="mt-2 grid gap-2 font-mono text-[0.78rem] sm:grid-cols-[1fr_auto_1fr] sm:items-center">
                  <span class="truncate rounded-lg border border-border bg-muted/50 px-3 py-2 text-muted-foreground line-through decoration-muted-foreground/40">{l.from}</span>
                  <ArrowRight class="hidden size-4 text-primary sm:block" />
                  <span class="truncate rounded-lg border border-primary/30 bg-frost px-3 py-2 text-accent-foreground">{l.to}</span>
                </div>
              </div>
            ))}
          </div>
          <div class="mt-8 flex items-center gap-3 rounded-2xl bg-saved-soft px-4 py-3 text-sm text-saved-ink">
            <span class="relative flex size-2.5"><span class="absolute inline-flex size-full animate-ping rounded-full bg-saved opacity-60"></span><span class="relative inline-flex size-2.5 rounded-full bg-saved"></span></span>
            Stripe connected · 4 products and 9 prices imported
          </div>
        </CardContent>
      </Card>
    </div>
  </div>
</section>
