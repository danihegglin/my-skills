---
interface Props {
  class?: string
  tone?: 'dark' | 'light'
}
const { class: className = '', tone = 'dark' } = Astro.props
---

<a href="/" class:list={['group inline-flex items-center gap-2.5 rounded-md', className]} aria-label="SubRocket home">
  <svg viewBox="0 0 32 32" class="size-8 transition-transform duration-500 group-hover:-translate-y-0.5 group-hover:rotate-[8deg]" aria-hidden="true">
    <defs>
      <linearGradient id="logo-g" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#11a06a" />
        <stop offset="1" stop-color="#053d29" />
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill="url(#logo-g)" />
    <path d="M16 5.5c3.6 2.7 5.4 6.7 5.4 11.2v4.1H10.6v-4.1c0-4.5 1.8-8.5 5.4-11.2z" fill="#fff" />
    <circle cx="16" cy="13.6" r="2.1" fill="#087a4f" />
    <path d="M13.4 22.8h5.2L16 27z" fill="#c6ef6a" class="origin-top transition-transform duration-500 group-hover:scale-y-125" />
  </svg>
  <span class:list={['font-display text-[1.2rem] font-semibold tracking-tight', tone === 'light' ? 'text-white' : 'text-foreground']}>SubRocket</span>
</a>
