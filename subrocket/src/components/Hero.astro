---
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/utils'
import { ArrowRight } from '@lucide/astro'
import CheckoutMockup from './CheckoutMockup.astro'

const proof = [
  { value: '30', unit: 'days', label: 'before a card expires, the first update request goes out' },
  { value: '1', unit: 'click', label: 'for a customer to pause instead of cancel' },
  { value: '0', unit: 'migrations', label: 'your subscriptions, prices and invoices stay in Stripe' },
]
---

<section class="grain relative overflow-hidden pt-32 pb-20 sm:pt-40 lg:pb-28">
  <div class="bg-grid absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_30%_30%,black,transparent_75%)]" aria-hidden="true"></div>
  <div class="absolute -top-40 right-[-10%] -z-10 size-[42rem] rounded-full bg-signal/15 blur-[120px]" aria-hidden="true"></div>

  <!-- Trajectory line -->
  <svg class="absolute right-0 top-24 -z-10 hidden h-[70%] w-1/2 lg:block" viewBox="0 0 1200 600" preserveAspectRatio="none" aria-hidden="true">
    <path d="M-20 560 C 300 540, 600 420, 760 260 S 1100 40, 1240 10" fill="none" stroke="#ff6a3d" stroke-opacity="0.18" stroke-width="1.5" stroke-dasharray="4 10" />
  </svg>

  <div class="mx-auto grid max-w-7xl items-center gap-16 px-5 sm:px-8 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="telemetry rise flex items-center gap-2 text-mint">
        <span class="blink inline-block size-2 rounded-full bg-mint"></span>
        For subscription businesses on Stripe
      </p>

      <h1 class="mt-6 text-[clamp(2.75rem,6.4vw,5.75rem)] font-extrabold">
        <span class="rise block" style="animation-delay: 80ms">Stripe bills your</span>
        <span class="rise block" style="animation-delay: 180ms">subscribers.</span>
        <span class="rise block text-signal" style="animation-delay: 300ms">SubRocket</span>
        <span class="rise block text-signal" style="animation-delay: 380ms">keeps them.</span>
      </h1>

      <p class="rise mt-8 max-w-xl text-lg leading-relaxed text-haze sm:text-xl" style="animation-delay: 500ms">
        Sell gift subscriptions at checkout, get new card details before old ones expire, and let customers pause or switch plans without emailing you.
      </p>

      <div class="rise mt-10 flex flex-col gap-4 sm:flex-row sm:items-center" style="animation-delay: 650ms">
        <a href="/signup" class={cn(buttonVariants({ size: 'lg' }), 'group h-14 rounded-full px-8 text-base font-bold shadow-[0_0_0_0_rgb(255_106_61/0.5)] transition-all hover:scale-[1.03] hover:shadow-[0_0_40px_0_rgb(255_106_61/0.45)]')}>
            Start Free Trial
            <ArrowRight class="size-5 transition-transform group-hover:translate-x-1" />
          </a>
        <a href="#checkout" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'h-14 rounded-full px-7 text-base font-semibold')}>See the gift checkout</a>
      </div>
      <p class="rise mt-4 text-sm text-haze" style="animation-delay: 700ms">14-day trial. No card required.</p>
    </div>

    <div class="rise thrust flex justify-center lg:col-span-5 lg:justify-end" style="animation-delay: 420ms">
      <CheckoutMockup />
    </div>
  </div>

  <!-- Social proof: product facts as telemetry readouts -->
  <div class="mx-auto mt-20 max-w-7xl px-5 sm:px-8">
    <dl class="grid divide-y divide-border rounded-2xl border border-border bg-ink-2/60 backdrop-blur sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {proof.map((item, i) => (
        <div class="rise p-6 sm:p-8" style={`animation-delay: ${800 + i * 100}ms`}>
          <dt class="sr-only">{item.value} {item.unit}</dt>
          <dd>
            <p class="font-display text-5xl font-extrabold">
              <span>{item.value}</span>
              <span class="ml-1 text-xl font-bold text-signal">{item.unit}</span>
            </p>
            <p class="mt-2 text-sm leading-relaxed text-haze">{item.label}</p>
          </dd>
        </div>
      ))}
    </dl>
    <p class="telemetry mt-6 text-center text-haze">Runs on Stripe Billing · Card data handled by Stripe · Works with your existing prices</p>
  </div>
</section>
