---
import { buttonVariants } from '@/components/ui/button'
import { Badge } from '@/components/ui/badge'
import { cn } from '@/lib/utils'
import { ArrowRight, Check } from '@lucide/astro'
import ProductPreview from './ProductPreview'

const perks = ['14-day free trial', 'No card required', 'Live in an afternoon']
const niches = ['Craft beer', 'Cosmetics', 'Coffee', 'Wine', 'Pet food', 'Snacks']
---

<section class="relative overflow-hidden pb-20 pt-28 sm:pt-36 lg:pb-28">

  <div class="mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:gap-12">
    <div>
      <Badge variant="outline" className="rise h-7 gap-2 rounded-full border-pop/20 bg-white/70 px-3 text-xs font-medium text-accent-foreground backdrop-blur">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-pop opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-pop"></span>
        </span>
        For subscription boxes on Stripe
      </Badge>

      <h1 class="mt-7 text-[clamp(2.8rem,6.4vw,5.2rem)] font-semibold">
        <span class="rise block" style="animation-delay: 80ms">More subscriptions sold.</span>
        <span class="rise block" style="animation-delay: 200ms"><span class="accent-text">Fewer</span> customers lost.</span>
      </h1>

      <p class="rise mt-7 max-w-lg text-lg leading-relaxed text-muted-foreground sm:text-xl" style="animation-delay: 340ms">
        Gift checkout, card rescue and a pause button for craft beer clubs, beauty boxes and every subscription that ships.
      </p>

      <div class="rise mt-9 flex flex-col gap-3 sm:flex-row sm:items-center" style="animation-delay: 460ms">
        <a href="/signup" class={cn(buttonVariants({ size: 'lg' }), 'group h-13 rounded-full px-7 text-base font-semibold shadow-[0_12px_30px_-10px_rgb(11_11_18/0.45)] transition-all hover:-translate-y-0.5 hover:shadow-[0_18px_40px_-12px_rgb(229_51_124/0.45)]')}>
          Start free trial
          <ArrowRight class="size-4 transition-transform group-hover:translate-x-1" />
        </a>
        <a href="/demo" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'h-13 rounded-full bg-white/70 px-6 text-base backdrop-blur')}>Book a demo</a>
      </div>
      <ul class="rise mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted-foreground" style="animation-delay: 540ms">
        {perks.map((p) => <li class="flex items-center gap-1.5"><Check class="size-4 text-pop" />{p}</li>)}
      </ul>
    </div>

    <div class="rise relative mx-auto w-full max-w-[30rem] lg:mr-0" style="animation-delay: 300ms">
      <div class="absolute -right-5 -top-5 -z-10 h-[85%] w-[85%] rounded-[2rem] bg-pop-soft" aria-hidden="true"></div>
      <ProductPreview client:load />
      <p class="mt-4 text-center text-xs text-muted-foreground">Try it: flip the gift switch, or hit cancel.</p>
    </div>
  </div>

  <div class="mx-auto mt-20 flex max-w-6xl flex-wrap items-center gap-x-3 gap-y-3 px-4 sm:px-6">
    <p class="eyebrow mr-2 text-[0.68rem] text-muted-foreground">Made for</p>
    {niches.map((n) => <span class="rounded-full border border-border bg-white px-4 py-1.5 text-sm font-medium">{n}</span>)}
    <span class="text-sm text-muted-foreground">and every subscription that ships.</span>
  </div>
</section>
