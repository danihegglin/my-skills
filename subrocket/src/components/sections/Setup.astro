---
import { Database, Lock, Webhook, ChartColumn } from '@lucide/astro'
import { setup, trust } from '@/content/landing'

const icons = { database: Database, lock: Lock, webhook: Webhook, chart: ChartColumn }
---

<section id="setup" class="scroll-mt-24 py-20 sm:py-28" aria-labelledby="setup-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end" data-reveal>
      <h2 id="setup-heading" class="text-[clamp(2.2rem,1.4rem+3.4vw,3.75rem)]">{setup.heading}</h2>
      <p class="max-w-[22rem] text-ink-muted md:text-right">{setup.body}</p>
    </div>

    <div class="relative mt-12">
    <div class="perforation absolute left-0 right-0 top-5 hidden h-1 md:block" aria-hidden="true"></div>
    <ol class="relative grid gap-10 md:grid-cols-3 md:gap-8">
      {setup.steps.map((s, i) => (
        <li class="relative" data-reveal style={`--d: ${i * 90}ms`}>
          <span class="relative z-10 flex size-11 items-center justify-center rounded-full border border-line-strong bg-paper font-display text-lg font-bold">{i + 1}</span>
          <h3 class="mt-5 text-xl tracking-tight">{s.title}</h3>
          <p class="mt-1.5 max-w-[19rem] text-ink-muted">{s.body}</p>
        </li>
      ))}
    </ol>
    </div>

    <!-- Objection: "Do I have to move off Stripe?" -->
    <div class="mt-20 grid gap-10 rounded-[1.75rem] bg-ink p-6 text-paper sm:p-10 lg:mt-24 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 lg:p-12" data-reveal>
      <div>
        <h2 class="max-w-[14ch] text-[clamp(2rem,1.4rem+2.6vw,3.1rem)]">{trust.heading}</h2>
        <p class="mt-4 max-w-[28rem] text-paper/70">{trust.body}</p>
      </div>
      <ul class="grid gap-x-8 gap-y-7 sm:grid-cols-2">
        {trust.items.map((item) => {
          const Icon = icons[item.icon]
          return (
            <li>
              <Icon class="size-5 text-pop" aria-hidden="true" />
              <h3 class="mt-3 font-sans text-base font-semibold tracking-normal">{item.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-paper/65">{item.body}</p>
            </li>
          )
        })}
      </ul>
    </div>
  </div>
</section>
