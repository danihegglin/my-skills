---
import Button from '@/components/ui/Button.astro'
import { cta, finalCta } from '@/content/landing'
---

<section class="px-4 pb-20 sm:px-6 sm:pb-28">
  <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[1.75rem] bg-kraft px-6 py-16 sm:px-12 sm:py-24" data-reveal>
    <div class="perforation absolute inset-x-6 top-5 h-1 sm:inset-x-12" aria-hidden="true"></div>
    <div class="grid items-end gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="max-w-[13ch] text-[clamp(2.6rem,1.5rem+4.6vw,5rem)] leading-[1.02]">{finalCta.heading}</h2>
        <p class="mt-5 max-w-[30rem] text-lg text-ink-muted">{finalCta.body}</p>
      </div>
      <div class="lg:justify-self-end">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button href={cta.primary.href} arrow data-cta="final">{cta.primary.label}</Button>
        </div>
        <p class="mt-4 text-sm text-ink-muted">{cta.reassurance}</p>
      </div>
    </div>
    <span class="stamp absolute bottom-6 right-8 hidden text-2xl lg:inline-flex" style="--stamp-rotate: -12deg" aria-hidden="true">Ships monthly</span>
  </div>
</section>
