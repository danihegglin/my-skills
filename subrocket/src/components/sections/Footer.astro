---
import Logo from '@/components/ui/Logo.astro'
import { footer, site, sources } from '@/content/landing'

const year = new Date().getFullYear()
---

<footer class="border-t border-line bg-card/60">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo />
        <p class="mt-4 max-w-xs text-sm text-ink-muted">{footer.blurb}</p>
        <a href={`mailto:${site.email}`} class="mt-5 inline-flex rounded-full border border-line-strong/60 px-4 py-2 text-sm font-medium transition-colors hover:border-ink">{site.email}</a>
      </div>
      <div class="grid grid-cols-3 gap-6 md:col-span-7">
      {footer.columns.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="eyebrow font-mono text-ink-muted" style="letter-spacing: 0.12em">{col.title}</h2>
          <ul class="mt-4 space-y-2.5 text-sm">
            {col.links.map((l) => <li><a href={l.href} class="text-ink/80 transition-colors hover:text-pop-deep">{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
      </div>
    </div>

    <div class="perforation my-10 h-1" aria-hidden="true"></div>
    <h2 class="eyebrow font-mono text-ink-muted" style="letter-spacing: 0.12em">Sources</h2>
    <ol id="sources" class="mt-3 scroll-mt-24 space-y-1 text-xs text-ink-muted">
      {sources.map((src, i) => (
        <li><span class="font-mono">{i + 1}.</span> <a href={src.href} rel="noopener" target="_blank" class="underline decoration-line-strong underline-offset-2 hover:text-pop-deep">{src.label}</a></li>
      ))}
    </ol>

    <div class="mt-10 flex flex-col justify-between gap-3 border-t border-line pt-6 text-xs text-ink-muted sm:flex-row">
      <p>&copy; {year} {site.name}</p>
      <p>{footer.disclaimer}</p>
    </div>
  </div>
</footer>
