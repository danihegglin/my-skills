---
import { Plus } from '@lucide/astro'
import { faq, site } from '@/content/landing'
---

<section id="faq" class="scroll-mt-24 py-20 sm:py-28" aria-labelledby="faq-heading">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
      <h2 id="faq-heading" class="text-[clamp(2.2rem,1.4rem+3.4vw,3.75rem)]">{faq.heading}</h2>
      <p class="mt-4 text-ink-muted">
        {faq.contact}{' '}
        <a href={`mailto:${site.email}`} class="font-medium text-ink underline decoration-pop/50 decoration-2 underline-offset-4 transition-colors hover:text-pop-deep">{site.email}</a>
      </p>
    </div>
    <div class="border-t border-line-strong/60">
      {faq.items.map((item, i) => (
        <details name="faq" class="faq-item group border-b border-line-strong/60" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left font-display text-lg font-semibold tracking-tight transition-colors hover:text-pop-deep">
            {item.q}
            <Plus class="faq-icon size-5 shrink-0 text-pop transition-[rotate] duration-300" aria-hidden="true" />
          </summary>
          <p class="max-w-[40rem] pb-6 text-ink-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
