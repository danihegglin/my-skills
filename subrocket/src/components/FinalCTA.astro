---
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/utils'
import { ArrowRight } from '@lucide/astro'
---

<section class="px-3 pb-24 sm:px-5 sm:pb-28">
  <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[2rem] bg-ink px-6 py-20 text-center text-white sm:px-10 sm:py-24" data-reveal>

    <div class="relative mx-auto max-w-3xl">
      <h2 class="text-[clamp(2.4rem,5.5vw,4.25rem)] font-semibold">Keep every box <span class="accent-text">shipping.</span></h2>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/signup" class={cn(buttonVariants({ size: 'lg' }), 'group h-14 rounded-full bg-pop px-8 text-base font-semibold text-white shadow-[0_18px_40px_-12px_rgb(0_0_0/0.35)] transition-all hover:-translate-y-0.5 hover:bg-pop')}>
          Start free trial
          <ArrowRight class="size-4 transition-transform group-hover:translate-x-1" />
        </a>
        <a href="/demo" class={cn(buttonVariants({ variant: 'ghost', size: 'lg' }), 'h-14 rounded-full px-7 text-base text-white hover:bg-white/10 hover:text-white')}>Book a demo</a>
      </div>
      <p class="mt-6 text-sm text-white/75">14 days free. No card required.</p>
    </div>
  </div>
</section>
