---
/*
 * subrocket landing page
 *
 * Aesthetic direction: "Ink & pop". Minimal, light, modern product page.
 * Typography: Geist (headlines at tight tracking, and body) + Geist Mono (labels).
 * Palette: canvas #f7f7f9, ink #0b0b12 (text, buttons), hot pink #e5337c (accent), pink-to-violet gradient on accent words.
 * Components: shadcn/ui Tabs, Switch, ToggleGroup, Input, Label, Sheet, Card, Badge, Accordion, Avatar, Separator.
 * Layout: split hero with an interactive product window, three compact feature cards, setup, FAQ.
 * Copy: short and number-led. Every statistic is sourced in the footer.
 */
import Layout from '@/layouts/Layout.astro'
import Header from '@/components/Header.astro'
import Hero from '@/components/Hero.astro'
import Features from '@/components/Features.astro'
import HowItWorks from '@/components/HowItWorks.astro'
import Testimonials from '@/components/Testimonials.astro'
import FAQ from '@/components/FAQ.astro'
import FinalCTA from '@/components/FinalCTA.astro'
import Footer from '@/components/Footer.astro'
---

<Layout
  title="subrocket: Gift Checkout, Card Rescue and Self-Service for Subscriptions"
  description="Sell gift subscriptions, fix cards before they fail, and turn cancels into pauses. Runs on your existing Stripe account."
>
  <Header />
  <main id="main">
    <Hero />
    <Features />
    <HowItWorks />
    <Testimonials />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
