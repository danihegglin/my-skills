---
/*
 * SubRocket landing page
 *
 * Aesthetic direction: "Clear sky". Minimal and light, cool blue-grey canvas with airy spacing.
 * Typography: Instrument Sans (display) + Instrument Serif italic (accent words) + Geist (body) + Geist Mono (labels).
 * Palette: canvas #f6f8fb, ink #0b1526, cobalt #2450e6 (action), teal #0f9b8e (anything rescued or saved).
 * Components: shadcn/ui Tabs, Switch, ToggleGroup, Input, Label, Sheet, Card, Badge, Accordion, Avatar, Separator.
 * Motion: staggered hero rise, scroll reveals, soft hover lifts. All respect reduced motion.
 * Layout: split hero with an interactive product window, journey row, bento modules, two-column setup and FAQ.
 */
import Layout from '@/layouts/Layout.astro'
import Header from '@/components/Header.astro'
import Hero from '@/components/Hero.astro'
import Problem from '@/components/Problem.astro'
import Modules from '@/components/Modules.astro'
import HowItWorks from '@/components/HowItWorks.astro'
import Testimonials from '@/components/Testimonials.astro'
import FAQ from '@/components/FAQ.astro'
import FinalCTA from '@/components/FinalCTA.astro'
import Footer from '@/components/Footer.astro'
---

<Layout
  title="SubRocket: Gift Checkout, Card Expiry Rescue and Self-Service for Stripe Subscriptions"
  description="Sell gift subscriptions, update cards before they expire, and let customers pause or switch plans. SubRocket runs on your existing Stripe account."
>
  <Header />
  <main id="main">
    <Hero />
    <Problem />
    <Modules />
    <HowItWorks />
    <Testimonials />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
