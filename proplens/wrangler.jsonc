{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proplens",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Static files are served without waking the worker; only the API runs code.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SIGNUPS", "class_name": "Signups" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Signups"] }],
  // Scan new listings in subscribed areas and send alert digests every three hours.
  "triggers": { "crons": ["17 */3 * * *"] },
  "vars": { "PUBLIC_URL": "https://proplens.vatia.workers.dev" },
  "workers_dev": true,
  "observability": { "enabled": true }
}
